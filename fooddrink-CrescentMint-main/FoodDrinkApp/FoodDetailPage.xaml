<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.FoodDetailPage"
             Title="Nutrition Details">
    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <!-- Food Image Section -->
            <Border StrokeThickness="0" Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,32,32" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#33000000" Offset="0,8" Radius="24" Opacity="0.2" />
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto">
                    <Image x:Name="FoodImage"
                           Aspect="AspectFill"
                           HeightRequest="280"
                           BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1E1E1E}" />
                    <!-- Gradient Overlay -->
                    <BoxView Grid.Row="1" Margin="0,-100,0,0" HeightRequest="100">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0.0" />
                                <GradientStop Color="{AppThemeBinding Light=#FAFAFA, Dark=#121212}" Offset="1.0" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>
                </Grid>
            </Border>

            <!-- Content Section -->
            <VerticalStackLayout Padding="20" Spacing="16" Margin="0,-20,0,0">
                <!-- Title Card -->
                <Border StrokeThickness="0" Padding="20" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252525}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#22000000" Offset="0,4" Radius="16" Opacity="0.1" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="NameLabel"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#212121, Dark=#FFFFFF}"
                               FontFamily="OpenSansSemibold" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label x:Name="CategoryLabel"
                                   FontSize="16"
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"
                                   FontFamily="OpenSansRegular" />
                            <Border BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}"
                                    Padding="12,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Label x:Name="CaloriesLabel"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2E7D32, Dark=#81C784}"
                                       FontFamily="OpenSansSemibold" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Nutrition Info Card -->
                <Border StrokeThickness="0" Padding="20" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252525}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#22000000" Offset="0,4" Radius="16" Opacity="0.1" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Nutrition Overview"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#2E7D32, Dark=#4CAF50}"
                               FontFamily="OpenSansSemibold" />
                        <Label x:Name="MacroLabel"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light=#212121, Dark=#FFFFFF}"
                               FontFamily="OpenSansSemibold" />
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEEEEE, Dark=#424242}" />
                        <Label x:Name="DescriptionLabel"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"
                               FontFamily="OpenSansRegular" />
                        <Border BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#4E342E}"
                                Padding="16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label x:Name="AllergyLabel"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#E65100, Dark=#FFCC80}"
                                   FontFamily="OpenSansSemibold" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Action Buttons -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="Read Summary"
                                BackgroundColor="{AppThemeBinding Light=#2E7D32, Dark=#4CAF50}"
                                TextColor="#FFFFFF"
                                FontFamily="OpenSansSemibold"
                                Clicked="OnSpeakClicked" />
                        <Button Grid.Column="1"
                                Text="Stop Reading"
                                Style="{StaticResource SecondaryButton}"
                                Clicked="OnStopSpeechClicked" />
                    </Grid>
                    <Button Text="Vibration Reminder"
                            BackgroundColor="{AppThemeBinding Light=#FF8F00, Dark=#FFA726}"
                            TextColor="#FFFFFF"
                            FontFamily="OpenSansSemibold"
                            Clicked="OnVibrateClicked" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
