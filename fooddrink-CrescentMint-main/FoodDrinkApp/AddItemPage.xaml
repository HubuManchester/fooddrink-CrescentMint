<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.AddItemPage"
             Title="Add Record">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <!-- Header Card -->
            <Border StrokeThickness="0" Padding="20" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252525}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#22000000" Offset="0,4" Radius="16" Opacity="0.1" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Add Food or Drink"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#212121, Dark=#FFFFFF}"
                           FontFamily="OpenSansSemibold" />
                    <Label Text="Record the full details of a meal worth remembering."
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"
                           FontFamily="OpenSansRegular" />
                </VerticalStackLayout>
            </Border>

            <!-- Basic Information Card -->
            <Border StrokeThickness="0" Padding="20" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252525}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#22000000" Offset="0,4" Radius="16" Opacity="0.1" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Basic Information"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#2E7D32, Dark=#4CAF50}"
                           FontFamily="OpenSansSemibold" />
                    <Entry x:Name="NameEntry"
                           Placeholder="Name"
                           FontFamily="OpenSansRegular" />
                    <Picker x:Name="CategoryPicker"
                            Title="Category"
                            FontFamily="OpenSansRegular">
                        <Picker.Items>
                            <x:String>Breakfast</x:String>
                            <x:String>Lunch</x:String>
                            <x:String>Dinner</x:String>
                            <x:String>Snack</x:String>
                            <x:String>Drink</x:String>
                        </Picker.Items>
                    </Picker>
                    <Editor x:Name="DescriptionEditor"
                            Placeholder="Description, ingredients, flavor, or context"
                            AutoSize="TextChanges"
                            HeightRequest="104"
                            FontFamily="OpenSansRegular" />
                </VerticalStackLayout>
            </Border>

            <!-- Nutrition Data Card -->
            <Border StrokeThickness="0" Padding="20" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252525}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#22000000" Offset="0,4" Radius="16" Opacity="0.1" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    <Label Text="Nutrition Data"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#FF8F00, Dark=#FFA726}"
                           FontFamily="OpenSansSemibold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Entry x:Name="CaloriesEntry"
                               Placeholder="Calories"
                               Keyboard="Numeric"
                               FontFamily="OpenSansRegular" />
                        <Entry x:Name="ProteinEntry"
                               Grid.Column="1"
                               Placeholder="Protein (g)"
                               Keyboard="Numeric"
                               FontFamily="OpenSansRegular" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Entry x:Name="CarbsEntry"
                               Placeholder="Carbs (g)"
                               Keyboard="Numeric"
                               FontFamily="OpenSansRegular" />
                        <Entry x:Name="FatEntry"
                               Grid.Column="1"
                               Placeholder="Fat (g)"
                               Keyboard="Numeric"
                               FontFamily="OpenSansRegular" />
                    </Grid>
                    <Entry x:Name="AllergyEntry"
                           Placeholder="Allergy Note or Dietary Restriction"
                           FontFamily="OpenSansRegular" />
                </VerticalStackLayout>
            </Border>

            <!-- Validation Panel -->
            <Border x:Name="ValidationPanel"
                    IsVisible="False"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#4E1E1E}"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Label x:Name="ValidationLabel"
                       TextColor="{AppThemeBinding Light=#C62828, Dark=#EF9A9A}"
                       FontAttributes="Bold"
                       FontFamily="OpenSansSemibold" />
            </Border>

            <!-- Save Button -->
            <Button Text="Save Record"
                    FontAttributes="Bold"
                    BackgroundColor="{AppThemeBinding Light=#2E7D32, Dark=#4CAF50}"
                    TextColor="#FFFFFF"
                    FontFamily="OpenSansSemibold"
                    Clicked="OnSaveClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
