<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.SettingsPage"
             Title="Settings">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <!-- Header Card -->
            <Border StrokeThickness="0" Padding="20" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252525}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#22000000" Offset="0,4" Radius="16" Opacity="0.1" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Accessibility Settings"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#212121, Dark=#FFFFFF}"
                           FontFamily="OpenSansSemibold" />
                    <Label Text="Large text takes effect immediately and remains active when switching pages."
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"
                           FontFamily="OpenSansRegular" />
                </VerticalStackLayout>
            </Border>

            <!-- Settings Card -->
            <Border StrokeThickness="0" Padding="20" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#252525}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#22000000" Offset="0,4" Radius="16" Opacity="0.1" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="20">
                    <!-- Theme Setting -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Theme Mode"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#2E7D32, Dark=#4CAF50}"
                               FontFamily="OpenSansSemibold" />
                        <Picker x:Name="ThemePicker"
                                Title="Choose App Theme"
                                SelectedIndexChanged="OnThemeChanged"
                                FontFamily="OpenSansRegular">
                            <Picker.Items>
                                <x:String>Use System Theme</x:String>
                                <x:String>Light Theme</x:String>
                                <x:String>Dark Theme</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEEEEE, Dark=#424242}" />

                    <!-- Large Text Setting -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Large Text Mode"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#FF8F00, Dark=#FFA726}"
                                   FontFamily="OpenSansSemibold" />
                            <Label Text="Increase text size for accessibility demonstration."
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"
                                   FontFamily="OpenSansRegular" />
                        </VerticalStackLayout>
                        <Switch x:Name="LargeTextSwitch"
                                Grid.Column="1"
                                Toggled="OnLargeTextToggled" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Preview Card -->
            <Border StrokeThickness="0" Padding="20" BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#4E342E}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="LargeTextPreviewTitle"
                           Text="Large Text Preview"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#E65100, Dark=#FFCC80}"
                           FontFamily="OpenSansSemibold" />
                    <Label x:Name="LargeTextPreviewBody"
                           Text="When enabled, this text and the rest of the page become visibly larger."
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"
                           FontFamily="OpenSansRegular" />
                </VerticalStackLayout>
            </Border>

            <!-- Status Label -->
            <Label x:Name="SettingsStatusLabel"
                   Text="Settings ready."
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#2E7D32, Dark=#4CAF50}"
                   FontFamily="OpenSansSemibold"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
